---
// Página de una lección. Se genera una por cada archivo de src/content/lessons/.
// URL: /pixel/p0-01/, /voxel/v1-02/…
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { visibleLessons, lessonXp, type Lesson } from "../../lib/lessons";
import { DISCIPLINES, FUNDAMENTOS } from "../../data/disciplines";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const list = await visibleLessons();
  return list.map((lesson) => ({
    params: { discipline: lesson.data.discipline, lesson: lesson.data.id },
    props: { lesson, all: list },
  }));
}

interface Props { lesson: Lesson; all: Lesson[] }
const { lesson, all } = Astro.props;
const l = lesson.data;
const d = DISCIPLINES.find((x) => x.id === l.discipline)!;
const level = d.levels.find((x) => x.n === l.level)!;
const { Content } = await render(lesson);
const href = (x: Lesson) => url(`${x.data.discipline}/${x.data.id}/`);
const prereqs = l.prerequisites.map((p) => all.find((x) => x.data.id === p)).filter((x): x is Lesson => !!x);
const same = all.filter((x) => x.data.discipline === l.discipline);
const i = same.findIndex((x) => x.data.id === l.id);
const prev = same[i - 1];
const next = same[i + 1];
const statusLabel = { borrador: "Borrador · solo en local", revisada: "En prueba", publicada: "" }[l.status];
const toolNames: Record<string, string> = { aseprite: "Aseprite", pixelorama: "Pixelorama", magicavoxel: "MagicaVoxel", blender: "Blender", godot: "Godot" };
const fundTitle = (f: string) => FUNDAMENTOS.levels.find((x) => x.n === Number(f.slice(1)))?.title;
---

<BaseLayout title={`${l.id.toUpperCase()} · ${l.title}`} discipline={l.discipline} description={l.summary}>
  <nav class="crumbs" aria-label="Migas">
    <a href={url(d.href)}>{d.name}</a> / <span>Nivel {l.level} · {level.title}</span>
  </nav>

  <header>
    <p class="eyebrow">{l.id.toUpperCase()} {statusLabel && <span class="status">{statusLabel}</span>}</p>
    <h1>{l.title}</h1>
    <p class="lead">{l.summary}</p>
    <ul class="meta">
      <li><span>Duración</span>~{l.duration} min</li>
      <li><span>Herramientas</span>{l.tools.map((t) => toolNames[t]).join(", ")}</li>
      <li><span>Pieza</span>{l.piece.name}{l.piece.canvas && ` · ${l.piece.canvas}`}</li>
      <li><span>XP</span>{lessonXp(lesson)} <small>({l.xp.piece} por la pieza)</small></li>
    </ul>
  </header>

  <div class="layout">
    <aside class="side">
      <div class="panel">
        <h2>Objetivos</h2>
        <ul>{l.objectives.map((o) => <li>{o}</li>)}</ul>
      </div>
      {prereqs.length > 0 && (
        <div class="panel">
          <h2>Antes, completa</h2>
          <ul>{prereqs.map((p) => <li><a href={href(p)}>{p.data.id.toUpperCase()} · {p.data.title}</a></li>)}</ul>
        </div>
      )}
      {l.fundamentals.length > 0 && (
        <div class="panel">
          <h2>Fundamentos</h2>
          <ul>{l.fundamentals.map((f) => <li><a href={url("fundamentos/")}>{f.toUpperCase()} · {fundTitle(f)}</a></li>)}</ul>
        </div>
      )}
    </aside>

    <article class="body">
      <Content />
    </article>
  </div>

  <nav class="pager" aria-label="Lecciones">
    {prev ? <a href={href(prev)}><small>← Anterior</small>{prev.data.id.toUpperCase()} · {prev.data.title}</a> : <span />}
    {next ? <a class="next" href={href(next)}><small>Siguiente →</small>{next.data.id.toUpperCase()} · {next.data.title}</a> : <span />}
  </nav>
</BaseLayout>

<style>
  .crumbs { font: .8rem var(--font-mono); color: var(--muted); margin-bottom: 16px; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .status { margin-left: 8px; padding: 2px 8px; border: 1px dashed var(--accent); text-transform: none; letter-spacing: 0; }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); }
  .meta { list-style: none; padding: 0; display: flex; gap: 28px; flex-wrap: wrap; margin: 20px 0 32px; }
  .meta span { display: block; font: .7rem var(--font-mono); color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .meta small { color: var(--muted); }
  .layout { display: grid; grid-template-columns: 280px 1fr; gap: 32px; align-items: start; }
  .side { display: grid; gap: 12px; position: sticky; top: 80px; }
  .side h2 { font: 600 .75rem var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 8px; }
  .side ul { margin: 0; padding-left: 1.1em; font-size: .9rem; }
  .side a { color: var(--accent); }
  .body { max-width: 760px; min-width: 0; }
  .body :global(h2) { font-size: 1.5rem; margin-top: 2em; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .body :global(blockquote) { margin: 0 0 1.5em; padding: 12px 16px; border-left: 3px solid var(--accent); background: var(--panel); color: var(--muted); }
  .body :global(code) { font-family: var(--font-mono); background: var(--panel-2); padding: 1px 6px; font-size: .9em; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 48px; }
  .pager a { display: block; text-decoration: none; padding: 14px 16px; border: 1px solid var(--line); background: var(--panel); }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; }
  .pager small { display: block; font: .72rem var(--font-mono); color: var(--accent); }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; }
  }
</style>
