---
// LABS — laboratorios para entender un concepto practicándolo.
// No sustituyen a Aseprite ni a MagicaVoxel: te preparan para usarlos mejor.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Inspector from "../../components/labs/SpriteInspector.astro";
import VoxViewer from "../../components/labs/VoxViewer.astro";
import RampLab from "../../components/labs/RampLab.astro";
import Animator from "../../components/labs/Animator.astro";
import SilhouetteLab from "../../components/labs/SilhouetteLab.astro";
import DitherLab from "../../components/labs/DitherLab.astro";
import LightLab from "../../components/labs/LightLab.astro";
---

<BaseLayout title="Labs" description="Laboratorios interactivos para entender conceptos de Pixel Art y Voxel Art.">
  <p class="eyebrow">Laboratorios</p>
  <h1>Labs</h1>
  <p class="lead">Pequeñas herramientas para entender un concepto practicándolo. No sustituyen a Aseprite ni a MagicaVoxel: te preparan para usarlos mejor.</p>

  <nav class="jump" aria-label="Laboratorios">
    <a href="#inspector">Inspector de sprites</a><a href="#vox">Visor voxel</a><a href="#rampas">Paletas y rampas</a><a href="#animacion">Mini-animador</a><a href="#siluetas">Siluetas</a><a href="#dithering">Dithering</a><a href="#luz">Luz y sombra</a>
  </nav>

  <h2 class="section-title" id="inspector">Inspector de sprites</h2>
  <p class="muted">Sube un PNG exportado a 1× desde Aseprite y busca huérfanos, píxeles sueltos y problemas de silueta o de valor.</p>
  <div data-discipline="pixel"><Inspector upload sprite="rock-noisy" title="Prueba con la roca ruidosa o sube tu sprite" /></div>

  <h2 class="section-title" id="vox">Visor voxel por etapas</h2>
  <p class="muted">Modelos .vox reales, paso a paso. Usa «Capas» para ver por dentro y descárgalos para abrirlos en MagicaVoxel.</p>
  <div data-discipline="voxel"><VoxViewer model="cofre" /></div>

  <h2 class="section-title" id="rampas">Paletas y rampas</h2>
  <p class="muted">Construye la rampa de un material, comprueba su valor en grises y llévatela a Aseprite.</p>
  <div data-discipline="pixel"><RampLab /></div>

  <h2 class="section-title" id="animacion">Mini-animador</h2>
  <p class="muted">Un idle de 4 frames: fíjate en cómo cambia la sensación al tocar la duración de cada frame.</p>
  <div data-discipline="pixel"><Animator preset="slime-idle" /></div>

  <h2 class="section-title" id="siluetas">Comparador de siluetas</h2>
  <p class="muted">Todos en negro y a tamaño real: si no sabes qué objeto es cada uno, la silueta no funciona. Añade tus PNG.</p>
  <div data-discipline="fundamentos"><SilhouetteLab /></div>

  <h2 class="section-title" id="dithering">Dithering</h2>
  <p class="muted">Cinco formas de mezclar dos colores. Compara a 1× y ampliado: el buen dithering casi desaparece a tamaño real.</p>
  <div data-discipline="pixel"><DitherLab /></div>

  <h2 class="section-title" id="luz">Luz y sombra</h2>
  <p class="muted">Mueve la luz alrededor de la esfera y cambia el número de tonos. Es el mismo razonamiento que usarás en cada sprite y en cada render.</p>
  <div data-discipline="fundamentos"><LightLab /></div>
</BaseLayout>

<style>
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); }
  .jump { display: flex; gap: 8px; flex-wrap: wrap; margin: 16px 0; }
  .jump a { border: 1px solid var(--line); padding: 6px 12px; text-decoration: none; font: 500 .85rem var(--font-head); }
  .jump a:hover { border-color: var(--fund); }
</style>
