---
// MAQUETA B — «Estudio»: el dashboard ES un editor de arte.
// Barra de herramientas = navegación · lienzo = lección actual · capas = disciplinas ·
// paleta = logros · línea de tiempo = portfolio (como los frames de una animación).
import MockLayout from "../../layouts/MockLayout.astro";
import PixelSprite from "../../components/PixelSprite.astro";
import VoxelIso from "../../components/VoxelIso.astro";
import { gem, potion, sword, chest, slime, voxelChest, voxelTower, islandDiorama } from "../../data/demo-art";

const tools = [
  { k: "T", n: "Taller", on: true }, { k: "P", n: "Pixel Forge" }, { k: "V", n: "Voxel Forge" },
  { k: "F", n: "Fundamentos" }, { k: "L", n: "Labs" }, { k: "G", n: "Portfolio" }, { k: "A", n: "Logros" },
];
const swatches = [
  { c: "#ff4fa3", n: "Primera silueta", got: true }, { c: "#ffb84d", n: "Rampa con hue shift", got: true },
  { c: "#38e1ff", n: "Primer render", got: true }, { c: "#2ec4a6", n: "Prop coherente" }, { c: "#e6c35c", n: "Valor en 3 tonos", got: true },
  { c: "#8f7bff", n: "Ciclo de 4 frames" }, { c: "#4ade80", n: "Tileset sin costuras" }, { c: "#ff6b4a", n: "Primer diorama" },
];
---

<MockLayout title="B · Estudio">
  <div class="app">
    <header class="menubar">
      <span class="logo">FORJA<span>//</span>ART</span>
      <span class="menu">Archivo</span><span class="menu">Ruta</span><span class="menu">Labs</span><span class="menu">Ayuda</span>
      <span class="spacer"></span>
      <span class="doc">taller.forja — Aprendiz · 340 XP</span>
    </header>

    <aside class="toolbar" aria-label="Navegación">
      {tools.map((t) => <a href="#" class={t.on ? "on" : ""} title={t.n}><kbd>{t.k}</kbd><span>{t.n}</span></a>)}
    </aside>

    <main class="canvas-area">
      <div class="tabs"><span class="tab on">P1-02 · siluetas.aseprite</span><span class="tab">V1-01 · rejilla.vox</span><span class="tab">+</span></div>
      <div class="canvas">
        <div class="stage">
          <div class="grid-overlay"></div>
          <PixelSprite {...potion} scale={26} label="Poción de 10×12 píxeles ampliada" />
        </div>
        <div class="lesson-card">
          <small>LECCIÓN ACTUAL · PIXEL FORGE · N1</small>
          <h1>Siluetas de objetos</h1>
          <p>Una poción tiene que leerse en negro puro, a 1×, antes de tener color.</p>
          <ol>
            <li class="done">La pieza</li><li class="done">El concepto</li><li class="now">Forja guiada · paso 3/6</li>
            <li>Tu versión</li><li>Errores típicos</li><li>Control de calidad</li>
          </ol>
          <a class="btn" href="#">Continuar →</a>
        </div>
        <div class="status">10×12 px · zoom 2600% · paleta 7 colores · <span class="ok">0 píxeles huérfanos</span></div>
      </div>
    </main>

    <aside class="panels">
      <section class="panel">
        <h2>Capas</h2>
        <div class="layer pixel"><span class="eye">◉</span><span class="name px">Pixel Forge</span><span class="lv">N1 · 18%</span><i style="--w:18%"></i></div>
        <div class="layer voxel"><span class="eye">◉</span><span class="name">Voxel Forge</span><span class="lv">N1 · 9%</span><i style="--w:9%"></i></div>
        <div class="layer fund"><span class="eye">◉</span><span class="name">Fundamentos</span><span class="lv">F02 · 10%</span><i style="--w:10%"></i></div>
      </section>
      <section class="panel">
        <h2>Paleta de logros <small>4/8</small></h2>
        <div class="swatches">{swatches.map((s) => <span class={s.got ? "got" : ""} style={`--c:${s.c}`} title={s.n}></span>)}</div>
        <p class="hint">Cada color es una habilidad demostrada con una pieza real.</p>
      </section>
      <section class="panel preview">
        <h2>Vista previa · Voxel</h2>
        <div class="pv"><VoxelIso voxels={voxelTower()} size={7} label="Torre voxel" /></div>
      </section>
    </aside>

    <footer class="timeline">
      <div class="tl-head"><span>Portfolio · línea de tiempo</span><span class="px">▶ 6 piezas</span></div>
      <div class="frames">
        <figure><PixelSprite {...gem} scale={5} label="Gema" /><figcaption>01 gema</figcaption></figure>
        <figure><VoxelIso voxels={voxelChest()} size={5} label="Cofre voxel" /><figcaption>02 cofre</figcaption></figure>
        <figure><PixelSprite {...sword} scale={3} label="Espada" /><figcaption>03 espada</figcaption></figure>
        <figure><PixelSprite {...chest} scale={4} label="Cofre" /><figcaption>04 cofre</figcaption></figure>
        <figure><VoxelIso voxels={islandDiorama()} size={3} label="Isla" /><figcaption>05 isla</figcaption></figure>
        <figure class="cur"><PixelSprite {...slime} scale={4} label="Slime" /><figcaption>06 slime</figcaption></figure>
      </div>
    </footer>
  </div>
</MockLayout>

<style>
  .app {
    display: grid; min-height: 100vh;
    grid-template: "menu menu menu" 36px "tools canvas panels" 1fr "tools time time" auto / 64px 1fr 300px;
    background: #0b0c10;
  }
  .menubar { grid-area: menu; display: flex; align-items: center; gap: 18px; padding: 0 14px; background: #15161d; border-bottom: 1px solid var(--line); font-size: .85rem; }
  .logo { font: 700 .95rem var(--font-head); } .logo span { color: var(--fund); }
  .menu { color: var(--muted); } .spacer { flex: 1; } .doc { font: .75rem var(--font-mono); color: var(--muted); }
  .toolbar { grid-area: tools; background: #15161d; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; padding: 8px 6px; }
  .toolbar a { text-decoration: none; display: grid; place-items: center; gap: 2px; padding: 8px 2px; border: 1px solid transparent; color: var(--muted); font-size: .6rem; text-align: center; }
  .toolbar a kbd { font: 600 1rem var(--font-mono); color: var(--text); }
  .toolbar a.on, .toolbar a:hover { background: var(--panel-2); border-color: var(--line); color: var(--text); }
  .toolbar a.on kbd { color: var(--fund); }
  .canvas-area { grid-area: canvas; display: flex; flex-direction: column; min-width: 0; }
  .tabs { display: flex; gap: 2px; background: #111219; padding: 4px 4px 0; }
  .tab { padding: 6px 14px; font: .75rem var(--font-mono); color: var(--muted); background: #15161d; }
  .tab.on { background: #1b1d26; color: var(--text); box-shadow: inset 0 2px 0 var(--pixel); }
  .canvas { flex: 1; position: relative; background: conic-gradient(#ffffff07 25%, transparent 0 50%, #ffffff07 0 75%, transparent 0) 0 0 / 24px 24px, #1b1d26; display: grid; grid-template-columns: 1fr 340px; align-items: center; gap: 24px; padding: 32px; }
  /* damero claro como en Aseprite: el contorno oscuro del sprite debe destacar sobre el fondo */
  .stage { position: relative; justify-self: center; line-height: 0; box-shadow: 0 0 0 1px #000, 0 30px 60px -20px #000;
    background: conic-gradient(#5a5e6e 25%, #4a4d5b 0 50%, #5a5e6e 0 75%, #4a4d5b 0) 0 0 / 52px 52px; }
  .grid-overlay { position: absolute; inset: 0; background-image: linear-gradient(#0003 1px, transparent 1px), linear-gradient(90deg, #0003 1px, transparent 1px); background-size: 26px 26px; pointer-events: none; }
  .lesson-card { background: #15161dee; border: 1px solid var(--line); padding: 20px; box-shadow: 4px 4px 0 #000; }
  .lesson-card small { font: .68rem var(--font-mono); color: var(--pixel); letter-spacing: .08em; }
  .lesson-card h1 { font-size: 1.7rem; margin-top: 6px; }
  .lesson-card p { color: var(--muted); font-size: .92rem; }
  .lesson-card ol { padding-left: 1.2em; font-size: .88rem; color: var(--muted); }
  .lesson-card li.done { color: var(--text); text-decoration: line-through; text-decoration-color: var(--pixel); }
  .lesson-card li.now { color: var(--pixel); font-weight: 600; }
  .btn { display: inline-block; margin-top: 8px; background: var(--pixel); color: #1a0010; padding: 8px 16px; font: 600 .9rem var(--font-head); text-decoration: none; box-shadow: 3px 3px 0 #000; }
  .status { position: absolute; left: 0; right: 0; bottom: 0; padding: 5px 12px; background: #111219; font: .72rem var(--font-mono); color: var(--muted); border-top: 1px solid var(--line); }
  .status .ok { color: #4ade80; }
  .panels { grid-area: panels; background: #15161d; border-left: 1px solid var(--line); display: flex; flex-direction: column; }
  .panel { padding: 14px; border-bottom: 1px solid var(--line); }
  .panel h2 { font: 600 .78rem var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); display: flex; justify-content: space-between; }
  .layer { position: relative; display: grid; grid-template-columns: 20px 1fr auto; gap: 8px; align-items: center; padding: 8px; background: var(--panel-2); margin-bottom: 4px; font-size: .88rem; overflow: hidden; }
  .layer i { position: absolute; left: 0; bottom: 0; height: 3px; width: var(--w); background: var(--c); }
  .layer.pixel { --c: var(--pixel); } .layer.voxel { --c: var(--voxel); } .layer.fund { --c: var(--fund); }
  .layer .eye { color: var(--c); } .layer .lv { font: .72rem var(--font-mono); color: var(--muted); }
  .swatches { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; }
  .swatches span { aspect-ratio: 1; background: repeating-linear-gradient(45deg, #ffffff10 0 3px, transparent 3px 6px); border: 1px solid var(--line); }
  .swatches span.got { background: var(--c); border-color: #000; box-shadow: inset -2px -2px 0 #0004, inset 2px 2px 0 #fff3; }
  .hint { font-size: .78rem; color: var(--muted); margin: 8px 0 0; }
  .pv { height: 170px; display: grid; place-items: center; background: radial-gradient(closest-side, rgba(56, 225, 255, .15), transparent); }
  .pv :global(svg) { width: auto; height: 100%; }
  .timeline { grid-area: time; background: #111219; border-top: 1px solid var(--line); padding: 8px 12px 12px; }
  .tl-head { display: flex; justify-content: space-between; font: .72rem var(--font-mono); color: var(--muted); margin-bottom: 8px; }
  .frames { display: flex; gap: 6px; overflow-x: auto; }
  .frames figure { flex: none; margin: 0; width: 92px; height: 92px; display: grid; place-items: center; grid-template-rows: 1fr auto; background: #1b1d26; border: 1px solid var(--line); padding: 8px 6px 4px; }
  .frames figure :global(svg.voxel-iso) { width: 60px; height: 56px; }
  .frames figure.cur { border-color: var(--pixel); }
  .frames figcaption { font: .62rem var(--font-mono); color: var(--muted); }
  @media (max-width: 1000px) {
    .app { grid-template: "menu" 36px "tools" auto "canvas" auto "panels" auto "time" auto / 1fr; }
    .toolbar { flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line); }
    .toolbar a { min-width: 64px; }
    .canvas { grid-template-columns: 1fr; padding: 20px 16px 48px; }
    .stage :global(svg) { width: 200px; height: auto; }
    .grid-overlay { background-size: 20px 20px; }
    .menu, .doc { display: none; }
  }
</style>
