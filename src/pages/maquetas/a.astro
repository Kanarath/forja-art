---
// MAQUETA A — «La Forja»: taller nocturno cálido, continuidad con Forja Mecha.
// Héroe con el diorama, dos rutas como bancos de trabajo y fundamentos como franja dorada.
import MockLayout from "../../layouts/MockLayout.astro";
import PixelSprite from "../../components/PixelSprite.astro";
import VoxelIso from "../../components/VoxelIso.astro";
import { gem, potion, sword, chest, slime, islandDiorama, voxelChest, voxelTower } from "../../data/demo-art";

const levels = Array.from({ length: 11 }, (_, i) => i);
const fundamentals = ["Valor", "Silueta", "Color", "Paletas", "Luz", "Materiales", "Composición", "Perspectiva", "Personajes", "Storytelling"];
---

<MockLayout title="A · La Forja">
  <header class="top">
    <a class="logo" href="#">FORJA<span>//</span>ART</a>
    <nav>
      <a class="on" href="#">Taller</a>
      <a class="p" href="#">Pixel Forge</a>
      <a class="v" href="#">Voxel Forge</a>
      <a href="#">Fundamentos</a>
      <a href="#">Labs</a>
      <a href="#">Portfolio</a>
    </nav>
    <div class="rank"><b>Aprendiz</b> · 340 XP</div>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">Bienvenido de vuelta al taller</p>
        <h1>Hoy forjas: <em>una poción que se lee a 1×</em></h1>
        <p class="lead">P1-02 · Siluetas de objetos · 40 min en Aseprite. Termina con un sprite de 16×16 en tu portfolio.</p>
        <div class="cta"><a class="btn" href="#">Continuar lección →</a><a class="ghost" href="#">Ver ruta</a></div>
        <div class="xp">
          <div class="xp-row"><span>Rango global</span><span>340 / 500 XP → Oficial</span></div>
          <div class="segbar">{Array.from({ length: 20 }, (_, i) => <i class={i < 13 ? "on" : ""} />)}</div>
        </div>
      </div>
      <div class="hero-art">
        <div class="glow"></div>
        <VoxelIso voxels={islandDiorama()} size={14} label="Diorama voxel de una isla con árbol, roca y agua" />
        <span class="tag">// diorama voxel real · 8×8×8</span>
      </div>
    </section>

    <section class="paths">
      <article class="bench pixel">
        <header>
          <div><small>PATH 02</small><h2 class="px">PIXEL FORGE</h2></div>
          <span class="pct">18%</span>
        </header>
        <div class="shelf">
          <div class="item done"><PixelSprite {...gem} scale={5} label="Gema" /></div>
          <div class="item done"><PixelSprite {...potion} scale={4} label="Poción" /></div>
          <div class="item now"><PixelSprite {...sword} scale={4} label="Espada" /></div>
          <div class="item lock"><PixelSprite {...chest} scale={4} label="Cofre" /></div>
          <div class="item lock"><PixelSprite {...slime} scale={4} label="Slime" /></div>
        </div>
        <ol class="route">{levels.map((n) => <li class={n < 1 ? "done" : n === 1 ? "now" : ""}>{n}</li>)}</ol>
        <p class="next">Siguiente: <b>N1 · Píxel y silueta</b></p>
      </article>

      <article class="bench voxel">
        <header>
          <div><small>PATH 01</small><h2>VOXEL FORGE</h2></div>
          <span class="pct">9%</span>
        </header>
        <div class="shelf">
          <div class="item done iso"><VoxelIso voxels={voxelChest()} size={6} label="Cofre voxel" /></div>
          <div class="item now iso"><VoxelIso voxels={voxelTower()} size={5} label="Torre voxel" /></div>
          <div class="item lock iso"><VoxelIso voxels={islandDiorama()} size={4} label="Diorama voxel" /></div>
        </div>
        <ol class="route">{levels.map((n) => <li class={n < 1 ? "done" : n === 1 ? "now" : ""}>{n}</li>)}</ol>
        <p class="next">Siguiente: <b>N1 · Pensar en vóxels</b></p>
      </article>
    </section>

    <section class="fund">
      <h3>Fundamentos compartidos</h3>
      <div class="chips">{fundamentals.map((f, i) => <span class={i < 1 ? "done" : i === 1 ? "now" : ""}><b>F{String(i + 1).padStart(2, "0")}</b> {f}</span>)}</div>
    </section>

    <section class="recent">
      <h3>Últimas piezas forjadas</h3>
      <div class="pieces">
        <figure><div class="frame"><PixelSprite {...gem} scale={7} label="Gema" /></div><figcaption>Gema 9×7 · F01 Valor</figcaption></figure>
        <figure><div class="frame"><VoxelIso voxels={voxelChest()} size={8} label="Cofre" /></div><figcaption>Cofre voxel · V0-01</figcaption></figure>
        <figure><div class="frame"><PixelSprite {...potion} scale={6} label="Poción" /></div><figcaption>Poción v2 · P1-02</figcaption></figure>
      </div>
    </section>
  </main>
</MockLayout>

<style>
  :global(body) { background: radial-gradient(1000px 600px at 75% 10%, rgba(255, 140, 60, .10), transparent 60%), var(--bg); }
  .top { display: flex; align-items: center; gap: 24px; padding: 14px 24px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: #0e0f14ee; backdrop-filter: blur(6px); z-index: 10; flex-wrap: wrap; }
  .logo { font: 700 1.3rem var(--font-head); text-decoration: none; }
  .logo span { color: var(--fund); }
  .top nav { display: flex; gap: 4px; flex-wrap: wrap; flex: 1; }
  .top nav a { text-decoration: none; padding: 6px 12px; font: 500 .9rem var(--font-head); color: var(--muted); border-bottom: 2px solid transparent; }
  .top nav a.on { color: var(--text); border-color: var(--fund); }
  .top nav a.p:hover { color: var(--pixel); } .top nav a.v:hover { color: var(--voxel); }
  .rank { font: .8rem var(--font-mono); color: var(--muted); } .rank b { color: var(--fund); }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 32px 16px 80px; }
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 32px; align-items: center; }
  .eyebrow { font: 500 .78rem var(--font-mono); color: var(--fund); text-transform: uppercase; letter-spacing: .1em; }
  h1 { font-size: clamp(2rem, 4.4vw, 3.2rem); } h1 em { font-style: normal; color: var(--pixel); }
  .lead { color: var(--muted); max-width: 520px; }
  .cta { display: flex; gap: 12px; margin: 20px 0 28px; }
  .btn { background: var(--fund); color: #1a1400; padding: 10px 18px; font: 600 .95rem var(--font-head); text-decoration: none; box-shadow: 3px 3px 0 #000; }
  .ghost { padding: 10px 18px; border: 1px solid var(--line); text-decoration: none; font: 600 .95rem var(--font-head); }
  .xp-row { display: flex; justify-content: space-between; font: .75rem var(--font-mono); color: var(--muted); margin-bottom: 6px; max-width: 460px; }
  .segbar { display: flex; gap: 3px; max-width: 460px; }
  .segbar i { flex: 1; height: 10px; background: var(--panel-2); }
  .segbar i.on { background: linear-gradient(var(--fund), #b8902f); }
  .hero-art { position: relative; aspect-ratio: 1; max-height: 440px; display: grid; place-items: center; }
  .hero-art :global(svg) { width: 86%; height: auto; position: relative; filter: drop-shadow(0 24px 30px #0008); animation: float 6s ease-in-out infinite; }
  .glow { position: absolute; inset: 15% 10% 5%; background: radial-gradient(closest-side, rgba(255, 170, 80, .22), transparent); }
  .tag { position: absolute; bottom: 0; right: 0; font: .72rem var(--font-mono); color: var(--muted); }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 48px 0 28px; }
  .bench { background: var(--panel); border: 1px solid var(--line); padding: 20px; position: relative; }
  .bench.pixel { --c: var(--pixel); box-shadow: 4px 4px 0 #000; }
  .bench.voxel { --c: var(--voxel); box-shadow: 0 20px 40px -20px rgba(56, 225, 255, .25); }
  .bench::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: var(--c); }
  .bench header { display: flex; justify-content: space-between; align-items: start; }
  .bench small { font: .72rem var(--font-mono); color: var(--c); letter-spacing: .1em; }
  .bench h2 { color: var(--c); font-size: 1.7rem; }
  .pct { font: 600 1.6rem var(--font-head); color: var(--c); }
  .shelf { display: flex; gap: 10px; margin: 10px 0 18px; background: repeating-linear-gradient(90deg, #ffffff05 0 1px, transparent 1px 12px), var(--panel-2); padding: 14px; overflow-x: auto; }
  .item { flex: none; width: 76px; height: 76px; display: grid; place-items: center; border: 1px solid var(--line); background: var(--bg); }
  .item.iso { padding: 8px; }
  .item.done { border-color: color-mix(in srgb, var(--c) 50%, transparent); }
  .item.now { border-color: var(--c); box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 30%, transparent); }
  .item.lock { opacity: .3; filter: grayscale(1); }
  .route { list-style: none; display: flex; gap: 4px; padding: 0; margin: 0; }
  .route li { flex: 1; text-align: center; font: .7rem var(--font-mono); padding: 4px 0; background: var(--panel-2); color: var(--muted); }
  .route li.done { background: color-mix(in srgb, var(--c) 40%, var(--panel-2)); color: var(--text); }
  .route li.now { background: var(--c); color: #0e0f14; font-weight: 600; }
  .next { margin: 12px 0 0; font-size: .9rem; color: var(--muted); } .next b { color: var(--text); }
  h3 { font-size: 1.05rem; color: var(--muted); font-weight: 600; }
  .fund { margin-bottom: 28px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips span { border: 1px solid var(--line); padding: 6px 12px; font-size: .85rem; color: var(--muted); }
  .chips b { font: 500 .75rem var(--font-mono); color: var(--fund); margin-right: 4px; }
  .chips .done { border-color: var(--fund); color: var(--text); }
  .chips .now { background: var(--fund); color: #1a1400; } .chips .now b { color: #1a1400; }
  .pieces { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
  .pieces figure { margin: 0; }
  .frame { aspect-ratio: 1; display: grid; place-items: center; background: conic-gradient(#ffffff06 25%, transparent 0 50%, #ffffff06 0 75%, transparent 0) 0 0 / 16px 16px, var(--panel); border: 1px solid var(--line); padding: 24px; }
  figcaption { font: .75rem var(--font-mono); color: var(--muted); margin-top: 6px; }
  @media (max-width: 820px) {
    .hero, .paths { grid-template-columns: 1fr; }
    .hero-art { max-height: 320px; }
    .top { gap: 10px; padding: 10px 16px; }
  }
</style>
