---
// Barra de XP segmentada (bloques, como una barra de vida de videojuego).
interface Props { xp: number; next: number; label?: string; nextLabel?: string; segments?: number }
const { xp, next, label = "Rango global", nextLabel = "", segments = 20 } = Astro.props;
const filled = Math.round((xp / next) * segments);
---

<div class="xp" role="meter" aria-valuemin="0" aria-valuemax={next} aria-valuenow={xp} aria-label={label}>
  <div class="xp-row"><span>{label}</span><span>{xp} / {next} XP{nextLabel && ` → ${nextLabel}`}</span></div>
  <div class="segbar">{Array.from({ length: segments }, (_, i) => <i class={i < filled ? "on" : ""} />)}</div>
</div>

<style>
  .xp { max-width: 460px; }
  .xp-row { display: flex; justify-content: space-between; font: .75rem var(--font-mono); color: var(--muted); margin-bottom: 6px; }
  .segbar { display: flex; gap: 3px; }
  .segbar i { flex: 1; height: 10px; background: var(--panel-2); }
  .segbar i.on { background: linear-gradient(var(--fund), #b8902f); }
</style>
