---
// Tira compacta de niveles: completados, actual y pendientes (se rellena con tu progreso).
import type { Level } from "../data/disciplines";
interface Props { levels: Level[]; discipline: string }
const { levels, discipline } = Astro.props;
const first = levels[0]?.n;
---

<ol class="strip" data-levels={discipline}>
  {levels.map((l) => (
    <li data-n={l.n} class={l.n === first ? "now" : "todo"} title={`${l.n} · ${l.title}`}>{l.n}</li>
  ))}
</ol>

<style>
  .strip { list-style: none; display: flex; gap: 4px; padding: 0; margin: 0; }
  .strip li { flex: 1; text-align: center; font: .7rem var(--font-mono); padding: 4px 0; background: var(--panel-2); color: var(--muted); }
  .strip li:global(.done) { background: color-mix(in srgb, var(--c, var(--accent)) 40%, var(--panel-2)); color: var(--text); }
  .strip li:global(.now) { background: var(--c, var(--accent)); color: #0e0f14; font-weight: 600; }
</style>
