---
// LAB · Dithering.
// Uso en MDX:  <DitherLab />   o   <DitherLab a="#1b1030" b="#ff4fa3" />
// Un degradado entre dos colores con distintos patrones, visto a tamaño real y ampliado.
// Lo importante: el dithering se LEE como un color intermedio a 1×; ampliado, es un patrón.
interface Props { a?: string; b?: string }
const { a = "#2a1d4a", b = "#ffb84d" } = Astro.props;
const METHODS = [
  { id: "none", name: "Sin dithering", note: "Un corte duro: dos zonas planas. Limpio y legible; a menudo es la mejor opción." },
  { id: "checker", name: "Damero 50 %", note: "Solo la franja central alterna píxeles. Es el dithering clásico de transición: suaviza el paso sin ensuciar." },
  { id: "bayer2", name: "Bayer 2×2", note: "Cinco niveles de mezcla con un patrón regular. Funciona en zonas grandes; en sprites pequeños se nota la trama." },
  { id: "bayer4", name: "Bayer 4×4", note: "Diecisiete niveles: degradado muy suave, pero el patrón «cruzado» es fácil de ver a poca distancia." },
  { id: "noise", name: "Ruido", note: "Píxeles al azar: parece suciedad. En pixel art casi nunca: el ojo busca orden." },
];
---

<section class="lab dither" data-lab="dither" data-a={a} data-b={b} data-methods={JSON.stringify(METHODS)}>
  <header class="lab-head"><span class="tag">LAB · DITHERING</span><b>Mezclar dos colores sin un tercero</b></header>
  <div class="tools">
    <label>Color A <input type="color" name="a" value={a} /></label>
    <label>Color B <input type="color" name="b" value={b} /></label>
    <label>Zoom <input type="range" name="zoom" min="4" max="16" value="10" /></label>
  </div>
  <div class="rows" data-rows></div>
  <p class="hint">Compara cada fila a <b>1×</b> (izquierda) y ampliada. El buen dithering casi desaparece a tamaño real; el malo se ve como ruido incluso de lejos.</p>
</section>

<script>
  import { ditherGradient } from "../../lib/pixel/shade.mjs";
  type M = { id: string; name: string; note: string };

  for (const root of document.querySelectorAll<HTMLElement>("[data-lab=dither]")) {
    const methods: M[] = JSON.parse(root.dataset.methods!);
    const box = root.querySelector<HTMLElement>("[data-rows]")!;
    const W = 32, H = 8;
    const grads = Object.fromEntries(methods.map((m) => [m.id, ditherGradient(m.id, W, H)]));

    function canvasFor(rows: string[], k: number, ca: string, cb: string) {
      const c = document.createElement("canvas");
      c.width = W * k; c.height = H * k;
      c.style.width = `${W * k}px`; c.style.height = `${H * k}px`;
      const g = c.getContext("2d")!;
      rows.forEach((r, y) => [...r].forEach((ch, x) => { g.fillStyle = ch === "b" ? cb : ca; g.fillRect(x * k, y * k, k, k); }));
      return c;
    }
    function render() {
      const ca = root.querySelector<HTMLInputElement>("input[name=a]")!.value;
      const cb = root.querySelector<HTMLInputElement>("input[name=b]")!.value;
      const k = Number(root.querySelector<HTMLInputElement>("input[name=zoom]")!.value);
      box.replaceChildren(...methods.map((m) => {
        const row = document.createElement("div");
        row.className = "row";
        const one = document.createElement("div");
        one.className = "one";
        one.append(canvasFor(grads[m.id], 1, ca, cb), canvasFor(grads[m.id], 2, ca, cb));
        const big = document.createElement("div");
        big.className = "big";
        big.append(canvasFor(grads[m.id], k, ca, cb));
        const txt = document.createElement("p");
        const b = document.createElement("b");
        b.textContent = m.name;
        txt.append(b, document.createTextNode(` — ${m.note}`));
        row.append(one, big, txt);
        return row;
      }));
    }
    root.addEventListener("input", render);
    render();
  }
</script>

<style>
  .lab { border: 1px solid var(--line); background: var(--panel); margin: 18px 0; }
  .lab-head { display: flex; gap: 12px; align-items: baseline; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .tag { font: 600 .7rem var(--font-mono); color: #0e0f14; background: var(--accent); padding: 2px 8px; }
  .tools { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; padding: 10px 14px; font-size: .85rem; }
  .tools label { display: flex; gap: 8px; align-items: center; }
  .tools input[type=color] { width: 40px; height: 28px; border: 1px solid var(--line); background: none; padding: 0; }
  .tools input[type=range] { accent-color: var(--accent); }
  .rows { display: grid; gap: 10px; padding: 0 14px; }
  .rows :global(.row) { display: grid; grid-template-columns: 110px minmax(0, auto) 1fr; gap: 14px; align-items: center; border-top: 1px solid var(--line); padding-top: 10px; }
  .rows :global(canvas) { image-rendering: pixelated; display: block; }
  .rows :global(.one) { display: grid; gap: 6px; justify-items: start; }
  .rows :global(.big) { overflow-x: auto; max-width: 100%; }
  .rows :global(p) { margin: 0; font-size: .85rem; color: var(--muted); }
  .rows :global(p b) { color: var(--text); }
  .hint { margin: 0; padding: 12px 14px; font-size: .85rem; color: var(--muted); }
  @media (max-width: 760px) { .rows :global(.row) { grid-template-columns: 1fr; } }
</style>
