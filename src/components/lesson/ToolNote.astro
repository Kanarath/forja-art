---
// Equivalencia en otro programa. Uso: <ToolNote tool="pixelorama"> … </ToolNote>
import Note from "./Note.astro";
const names: Record<string, string> = { pixelorama: "Pixelorama", libresprite: "LibreSprite", aseprite: "Aseprite", blender: "Blender", goxel: "Goxel", godot: "Godot", magicavoxel: "MagicaVoxel" };
const { tool } = Astro.props;
---

<Note variant="tool" label={`Si usas ${names[tool] ?? tool}`}><slot /></Note>
