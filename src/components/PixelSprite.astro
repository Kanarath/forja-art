---
// Dibuja un sprite a partir de DATOS: una paleta y filas de índices.
// Cada carácter de `rows` es un índice de `palette` ("." = transparente).
// Se genera un <path> por color, con un rectángulo por cada tramo horizontal de
// píxeles iguales: el sprite es exacto a cualquier escala y pesa poco aunque sea grande
// (una escena de 64×40 o un tile repetido 3×3).
interface Props {
  palette: Record<string, string>;
  rows: string[];
  scale?: number; // tamaño en pantalla de cada píxel
  label: string; // texto alternativo
}
const { palette, rows, scale = 8, label } = Astro.props;
const width = Math.max(...rows.map((r) => r.length));
const height = rows.length;
const paths = new Map<string, string>(); // color → datos del path
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    let n = 1;
    while (row[x + n] === ch) n++;
    const fill = palette[ch];
    if (fill) paths.set(fill, (paths.get(fill) ?? "") + `M${x} ${y}h${n}v1h-${n}z`);
    x += n;
  }
});
---

<svg
  class="pixel-sprite"
  viewBox={`0 0 ${width} ${height}`}
  width={width * scale}
  height={height * scale}
  shape-rendering="crispEdges"
  role="img"
  aria-label={label}
>
  {[...paths].map(([fill, d]) => <path d={d} fill={fill} />)}
</svg>
