---
// Dashboard de una disciplina: cabecera con su arte, progreso y el mapa de niveles.
// El mapa es un camino vertical: cada nivel muestra qué aprendes y qué pieza forjas.
// Pixel, Voxel y Fundamentos usan el mismo componente; solo cambian los datos y el tema.
// Tu progreso (porcentaje, niveles hechos, siguiente lección) se rellena en el navegador.
import type { Discipline } from "../data/disciplines";
import LevelStrip from "./LevelStrip.astro";
import XpBar from "./XpBar.astro";
import { lessonsOf } from "../lib/lessons";
import { buildCatalog } from "../lib/catalog";
import { emptyState, nextLesson } from "../lib/game/core";
import { ROUTE } from "../data/route";
import { url } from "../lib/url";

interface Props { d: Discipline }
const { d } = Astro.props;
// Las lecciones salen del contenido (src/content/lessons), no de este componente.
const lessons = await lessonsOf(d.id);
const lessonsAt = (n: number) => lessons.filter((l) => l.data.level === n);
const prefix = d.id === "fundamentos" ? "F" : "N";
const labelOf = (n: number) => `${prefix}${d.id === "fundamentos" ? String(n).padStart(2, "0") : n}`;
const first = nextLesson((await buildCatalog()).lessons, emptyState(), ROUTE, d.id);
const firstLevel = d.levels[0].n;
---

<section class="d-hero">
  <div>
    <p class="eyebrow">{d.path}</p>
    <h1 class={d.id === "pixel" ? "px" : ""}>{d.name}</h1>
    <p class="lead">{d.tagline}</p>
    <ul class="facts">
      <li><span>Herramienta</span>{d.tool}</li>
      <li><span>Progreso</span><b data-pct={d.id}>0%</b></li>
      <li><span>Lecciones</span>{lessons.length}</li>
    </ul>
    <XpBar scope={d.id} label="Rango" />
    <div class={`now-card ${first ? "" : "is-empty"}`} data-next={d.id}>
      <small>SIGUIENTE EN TU RUTA</small>
      <div class="has">
        <b><span data-next-id>{first?.id.toUpperCase()}</span> · <span data-next-title>{first?.title}</span></b>
        <p>Pieza: <span data-next-piece>{first?.piece}</span></p>
        <a class="btn" data-next-link href={first?.href ?? "#"}>Empezar →</a>
      </div>
      <div class="none">
        <b>Lecciones en la forja</b>
        <p>Las lecciones de esta ruta se están escribiendo (fase 2). El mapa muestra lo que aprenderás.</p>
      </div>
    </div>
  </div>
  <div class="d-art"><slot name="art" /></div>
</section>

<LevelStrip levels={d.levels} discipline={d.id} />

<h2 class="section-title" id="ruta">Mapa de aprendizaje</h2>
<ol class="map" data-levels={d.id}>
  {d.levels.map((l) => (
    <li data-n={l.n} class={l.n === firstLevel ? "now" : "todo"}>
      <span class="node">{labelOf(l.n)}</span>
      <div class="card">
        <div class="card-head">
          <h3>{l.title}</h3>
          <span class="state" data-state>{l.n === firstLevel ? "Siguiente" : "Pendiente"}</span>
        </div>
        <p>{l.summary}</p>
        <p class="piece">◆ Pieza: {l.piece}</p>
        {lessonsAt(l.n).length > 0 && (
          <ul class="lessons">
            {lessonsAt(l.n).map((x) => (
              <li data-lesson-item={x.data.id}>
                <a href={url(`${x.data.discipline}/${x.data.id}/`)}>
                  <span class="check" aria-hidden="true"></span>
                  <span class="lid">{x.data.id.toUpperCase()}</span> {x.data.title}
                  <span class="dur">{x.data.duration} min</span>
                  {x.data.status !== "publicada" && <span class="st">{x.data.status === "borrador" ? "borrador" : "en prueba"}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .d-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: center; margin-bottom: 28px; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); color: var(--accent); }
  h1.px { font-weight: 400; }
  .facts { list-style: none; padding: 0; display: flex; gap: 24px; flex-wrap: wrap; margin: 20px 0; }
  .facts li { font-size: .95rem; }
  .facts span { display: block; font: .7rem var(--font-mono); color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .now-card { border: 1px solid var(--accent); background: var(--panel); padding: 16px; max-width: 520px; }
  .now-card small { font: .7rem var(--font-mono); color: var(--accent); letter-spacing: .08em; display: block; }
  .now-card b { font: 600 1.15rem var(--font-head); }
  .now-card p { color: var(--muted); margin: 6px 0 10px; font-size: .92rem; }
  .now-card { margin-top: 16px; }
  .now-card .none { display: none; }
  .now-card:global(.is-empty) .has { display: none; }
  .now-card:global(.is-empty) .none { display: block; }
  .now-card .btn { padding: 8px 14px; font-size: .88rem; }
  .facts b { font-weight: 500; }
  .check { width: 14px; height: 14px; border: 1px solid var(--line); flex: none; align-self: center; }
  :global(.is-done) .check { background: var(--accent); border-color: var(--accent); }
  :global(.is-started) .check { background: linear-gradient(135deg, var(--accent) 50%, transparent 50%); border-color: var(--accent); }
  :global(.is-done) .lid { text-decoration: line-through; }
  .d-art { display: grid; place-items: center; min-height: 280px; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 14%, transparent), transparent); }
  .d-art :global(svg.voxel-iso) { width: 80%; max-width: 380px; height: auto; }

  .map { list-style: none; padding: 0; margin: 0; position: relative; }
  .map::before { content: ""; position: absolute; left: 23px; top: 8px; bottom: 8px; width: 2px; background: repeating-linear-gradient(var(--line) 0 6px, transparent 6px 10px); }
  .map > li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; margin-bottom: 12px; position: relative; }
  .node { width: 48px; height: 48px; display: grid; place-items: center; font: 600 .85rem var(--font-mono); background: var(--bg); border: 2px solid var(--line); color: var(--muted); z-index: 1; }
  :global([data-discipline="pixel"]) .node { box-shadow: 3px 3px 0 #000; }
  :global([data-discipline="voxel"]) .node { box-shadow: 0 8px 18px -8px color-mix(in srgb, var(--accent) 60%, transparent); }
  :global(.done) > .node { border-color: var(--accent); color: var(--text); }
  :global(.now) > .node { background: var(--accent); border-color: var(--accent); color: #0e0f14; }
  .card { background: var(--panel); border: 1px solid var(--line); padding: 14px 16px; }
  :global(.now) > .card { border-color: var(--accent); }
  :global(.todo) > .card { opacity: .78; }
  .card-head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .card h3 { font-size: 1.1rem; margin: 0; }
  .state { font: .7rem var(--font-mono); color: var(--muted); white-space: nowrap; }
  :global(.now) .state, :global(.done) .state { color: var(--accent); }
  .card p { margin: 6px 0 0; color: var(--muted); font-size: .92rem; }
  .card .piece { color: var(--text); font-size: .85rem; }
  .lessons { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 4px; }
  .lessons a { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; text-decoration: none; padding: 8px 10px; background: var(--panel-2); border-left: 2px solid var(--accent); font-size: .92rem; }
  .lessons a:hover { background: color-mix(in srgb, var(--accent) 12%, var(--panel-2)); }
  .lid { font: 600 .75rem var(--font-mono); color: var(--accent); }
  .dur { margin-left: auto; font: .72rem var(--font-mono); color: var(--muted); }
  .st { font: .68rem var(--font-mono); color: var(--accent); border: 1px dashed var(--accent); padding: 0 6px; }
  @media (max-width: 860px) {
    .d-hero { grid-template-columns: 1fr; }
    .d-art { min-height: 200px; order: -1; }
  }
</style>
