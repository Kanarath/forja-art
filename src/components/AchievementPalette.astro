---
// Paleta de logros (idea de la maqueta B): cada logro es una muestra de color
// que se «pinta» cuando lo consigues con una pieza real.
interface Ach { id: string; name: string; color: string; got: boolean }
interface Props { items: Ach[] }
const { items } = Astro.props;
const got = items.filter((i) => i.got).length;
---

<div class="palette">
  <div class="head"><span>Paleta de logros</span><span class="mono">{got}/{items.length}</span></div>
  <ul class="swatches">
    {items.map((a) => (
      <li class={a.got ? "got" : ""} style={`--c:${a.color}`} title={a.got ? a.name : `${a.name} (pendiente)`}>
        <span class="sr">{a.name}{a.got ? "" : " (pendiente)"}</span>
      </li>
    ))}
  </ul>
  <p class="hint">Cada color es una habilidad demostrada con una pieza real.</p>
</div>

<style>
  .head { display: flex; justify-content: space-between; font: 600 .78rem var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 10px; }
  .swatches { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(8, 1fr); gap: 5px; }
  .swatches li { aspect-ratio: 1; background: repeating-linear-gradient(45deg, #ffffff10 0 3px, transparent 3px 6px); border: 1px solid var(--line); }
  .swatches li.got { background: var(--c); border-color: #000; box-shadow: inset -3px -3px 0 #0004, inset 3px 3px 0 #fff3; }
  .hint { font-size: .8rem; color: var(--muted); margin: 10px 0 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
