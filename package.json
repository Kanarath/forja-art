{
  "name": "forja-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FORJA//ART — academia personal de Pixel Art y Voxel Art",
  "scripts": {
    "sprites": "node tools/build-sprites.mjs",
    "predev": "npm run assets",
    "dev": "astro dev",
    "prebuild": "npm run assets",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/",
    "validate": "npm run assets && node tools/validate.mjs",
    "check": "npm test && npm run validate",
    "assets": "node tools/build-sprites.mjs && node tools/build-vox.mjs",
    "deploy": "node tools/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "astro": "7.4.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "linkedom": "0.18.15"
  }
}
